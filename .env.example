# DATABASE_URL is added automatically when Neon is installed from Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
APP_URL=https://your-project.vercel.app
OWNER_PASSWORD=use-a-long-unique-private-passphrase
SESSION_SECRET=use-a-long-random-secret-at-least-32-characters
RESEND_API_KEY=re_replace_me
FROM_EMAIL=Agreements <agreements@your-verified-domain.com>
